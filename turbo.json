{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"]
    }
  }
}
