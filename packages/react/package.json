{
  "name": "@valence/react",
  "repository": {
    "type": "git",
    "url": "https://github.com/cjones26/valence-design-system.git",
    "directory": "packages/react"
  },
  "version": "0.1.0",
  "description": "Valence design system — React (web) components.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && rollup -c",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@valence/tokens": "workspace:*",
    "@valence/types": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "postcss-import": "^17.0.0",
    "postcss-url": "^10.1.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.62.5",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
